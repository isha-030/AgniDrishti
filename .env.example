# AgniDrishti Environment Configuration
# Optional: Get your free NASA FIRMS MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Pipeline & Spatial Thresholds
FACILITY_PROXIMITY_M=1500.0
DEFAULT_SEARCH_RADIUS_M=2500.0
MIN_BASELINE_SAMPLES=2
ANOMALY_ZSCORE_THRESHOLD=2.0
DBSCAN_EPS_KM=1.0
DBSCAN_MIN_SAMPLES=1

# SQLite storage
SQLITE_DB_PATH=agnidrishti.db
